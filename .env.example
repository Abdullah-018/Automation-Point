# Public Appwrite connection values. These are safe to expose to the browser.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=<APPWRITE_PROJECT_ID>

# Optional IDs for future contact/data features. They are not used by the
# current information-only portfolio website.
NEXT_PUBLIC_APPWRITE_DATABASE_ID=<DATABASE_ID>
NEXT_PUBLIC_APPWRITE_CONTACT_TABLE_ID=<CONTACT_TABLE_ID>
